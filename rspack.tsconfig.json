{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["es2022"],
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true  
  },
  "include": ["./src/server/*"]
}
